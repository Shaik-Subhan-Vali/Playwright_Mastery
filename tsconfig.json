{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node" // This line tells TypeScript to include Node.js types
    ]
  },
  "include": [
    "**/*.ts" // Include all TypeScript files in your project
  ]
}
